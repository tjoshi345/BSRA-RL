<mujocoinclude>
  <worldbody>
    <!-- MEMBER TODO 2.1: Add body cart at 0 0 0.20, joint slider, and
         geom cart_geom. Use the dimensions and explicit mass in docs/ONBOARDING.md.
         Nest body pole at 0 0 0.08 with joint hinge and geom pole_geom.
         At zero joint positions, the pole points up along +z. -->
	<body name="cart" pos="0 0 0.20">
		<geom name="cart_geom" type="box" size="0.15 0.10 0.08" mass="10"/>
		<joint name="slider" type="slide" axis="1 0 0" limited="true" range="-1.25 1.25" damping="1"/>

		<body name="pole" pos="0 0 0.08">
			<geom name="pole_geom" type="capsule" fromto="0 0 0 0 0 0.75" size="0.04" mass="5"/>
			<joint name="hinge" type="hinge" axis="0 1 0" limited="true" range="-90 90" damping="1"/>
		</body>
	</body>
  </worldbody>
  <actuator>
    <!-- MEMBER TODO 2.2: Add cart_motor on slider. Set the control limit
         and gear explicitly. The pole has no actuator. -->
	<motor name="cart_motor" joint="slider" ctrllimited="true" ctrlrange="-3 3" gear="100"/>
  </actuator>
</mujocoinclude>
